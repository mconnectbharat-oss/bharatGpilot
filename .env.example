# ==========================================
# BharatGPilot Environment Configuration
# ==========================================
# Copy to .env locally or configure these in Vercel/Railway.
# NEVER commit real API keys.

NODE_ENV=development
PORT=3000
APP_NAME=BharatGPilot
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ==========================================
# AI Router
# Set a comma-separated priority order. "auto" mode uses this order and fails over on provider errors.
MODEL_ROUTER_ORDER=openrouter,gemini,groq,mistral,nvidia,cloudflare,huggingface,pollinations

# ==========================================
# OpenRouter
# ==========================================
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Examples:
# openrouter/free
# nvidia/nemotron-3-ultra:free
# poolside/laguna-s-2.1:free
# nvidia/nemotron-3.5-lightning:free
# inclusionai/ling-3.0-flash-sante:free
# nvidia/nemotron-3-super:free
# thinking-machines/inkling:free
# cohere/north-mini-code:free
# thinking-machines/inkling-small:free
# poolside/laguna-xs-2.1:free
# apodex/apodex-1.1-mini:free
OPENROUTER_MODEL=openrouter/free

# ==========================================
# Google Gemini
# ==========================================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Groq
# ==========================================
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-70b-versatile

# ==========================================
# Mistral AI
# ==========================================
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# ==========================================
# Cloudflare Workers AI
# ==========================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast

# ==========================================
# Hugging Face
# ==========================================
HUGGINGFACE_API_KEY=your_huggingface_api_key
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct

# ==========================================
# NVIDIA NIM
# ==========================================
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/glm-5-3-flash

# ==========================================
# Pollinations AI (Optional)
# ==========================================
POLLINATIONS_API_KEY=your_pollinations_api_key
POLLINATIONS_MODEL=openai/gpt-5.4-nano

# ==========================================
# GitHub
# ==========================================
GITHUB_TOKEN=your_github_token
GITHUB_API_BASE_URL=https://api.github.com

# ==========================================
# Upload limits
# ==========================================
MAX_FILE_SIZE_MB=10
