
# ==========================================
# BharatGPilot Environment Configuration
# Copy this file to .env and add credentials
# ==========================================

NODE_ENV=development
PORT=3000

# ==========================================
# OpenRouter (Model Variety)
# ==========================================
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=your_default_model_id

# ==========================================
# Google Gemini (Model Variety)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_gemini_model_id

# ==========================================
# Groq(Model Variety)
# ==========================================
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=your_groq_model_id

#  ==========================================
# Mistral AI (Model Variety)
# ==========================================
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=your_mistral_model_id

# ==========================================
# Cloudflare Workers AI (Model Variety)
# ==========================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_MODEL=your_cloudflare_model_id

# ==========================================
# Hugging Face (Model Variety)
# ==========================================
HUGGINGFACE_API_KEY=your_huggingface_api_key
HUGGINGFACE_MODEL=your_huggingface_model_id

# ==========================================
# NVIDIA NIM (Model Variety)
# ==========================================
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=your_nvidia_model_id

# ==========================================
# Pollinations AI (Model Variety)
# ==========================================
POLLINATIONS_API_KEY=your_pollinations_api_key
POLLINATIONS_MODEL=your_pollinations_model_id

# ==========================================
Claude Model (Model Variety)
# ==========================================
CLAUDE_MODEL=your_claude_model_id
CLAUDE_MODEL_KEY=your-claude_model_api_key
# ==========================================
# Ollama (Local/Private)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
# ==========================================
# GitHub (Free for public)
GITHUB_TOKEN=your_github_token
GITHUB_API_BASE_URL=https://api.github.com
# Application
# ==========================================
APP_NAME=BharatGPilot
APP_URL=http://localhost:3000

# ==========================================
# CORS
# ==========================================
FRONTEND_URL=http://localhost:3000

# ==========================================
# File Upload Configuration
# ==========================================
MAX_FILE_SIZE_MB=10
